PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mern-shop?replicaSet=rs0&directConnection=true
TEST_MONGO_URI=mongodb://127.0.0.1:27017/mern-shop-test?replicaSet=rs0&directConnection=true
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
VNPAY_TMN_CODE=replace_with_sandbox_terminal
VNPAY_HASH_SECRET=replace_with_sandbox_hash_secret
VNPAY_RETURN_URL=http://localhost:5000/api/orders/vnpay/return
# Required sandbox quote rate; set your own value, no live FX lookup is performed.
VNPAY_USD_TO_VND_RATE=
# Configure only for your verified reverse-proxy topology (e.g. one proxy on Render).
TRUST_PROXY_HOPS=0
# Recommended on Render Free: HTTPS email provider (verified sender required).
RESEND_API_KEY=
# MAIL_FROM below must be a sender/domain authorized by the chosen provider.
# Optional alternative on hosts with SMTP access:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=replace_with_sender_app_password
MAIL_FROM=L4LStore <your-sender@gmail.com>
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=replace_me
R2_PUBLIC_URL=https://your-public-r2-domain
