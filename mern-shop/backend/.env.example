PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mern-shop?replicaSet=rs0&directConnection=true
TEST_MONGO_URI=mongodb://127.0.0.1:27017/mern-shop-test?replicaSet=rs0&directConnection=true
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
# Optional: leave blank until you have your own VNPay sandbox merchant.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5000/api/orders/vnpay/return
# Set only for a verified reverse-proxy topology; local requests use 0.
TRUST_PROXY_HOPS=0
# Email confirmation is disabled; SMTP/Resend are not required.
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=replace_me
R2_PUBLIC_URL=https://your-public-r2-domain
